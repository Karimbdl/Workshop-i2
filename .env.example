# Copier en .env et adapter si besoin. Aucune valeur secrète ici : les secrets sont dans ./secrets.

# Adresse et port publiés par la passerelle (seul point d'entrée exposé)
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080

# Limites de débit de la passerelle (par adresse IP)
API_RATE_LIMIT=50r/s
API_RATE_BURST=100
LOGIN_RATE_LIMIT=5r/s
LOGIN_RATE_BURST=10
MAX_CONN_PER_IP=100

LOG_LEVEL=INFO

# Grafana, publié uniquement sur 127.0.0.1 (PC Hôte)
GRAFANA_PORT=3000
